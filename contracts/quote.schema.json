{
  "type_id": 1,
  "name": "quote",
  "schema_version": 2,
  "schema_version_note": "v1 归档（如 2026-08-17/08-18 的 QuantScout 快照）缺失 open 字段；v2 起 open 为必填。BanDB 的 QuoteSnapshot 校验器已经按 v2 强制要求 open——本字段只是把这条既有事实显式声明成可追溯的版本号，不是本次新增的校验行为。",
  "key_prefix": "quote:",
  "key_layout": {
    "delimiter": ":",
    "fields": ["prefix", "date", "code"]
  },
  "time_semantics": {
    "kind": "none",
    "key_field": ""
  },
  "producer": "QuantScout",
  "consumers": ["BanDB", "QuantBrew"],
  "pit_semantics": "交易日快照；quote_timestamp 字段反解出真实成交时点。BanDB 时态内核（M0）的写入时间即 as-of 时间，本类型不区分有效时间与写入时间（双时态统一查询是方案 M2+ 的范围，见 docs/rfc/时态内核-M0-版本化与as-of.md）。",
  "idempotency_key": ["date", "code"],
  "required_fields": ["code", "date", "open", "high", "low", "close", "volume"],
  "units": {
    "volume": "lots"
  },
  "validation_rules": [
    {"kind": "positive_price", "fields": ["open", "high", "low", "close"], "error_code": "0x3002"},
    {"kind": "non_negative", "fields": ["volume"], "error_code": "0x3002"},
    {"kind": "ohlc_consistency", "error_code": "0x3003"},
    {"kind": "pct_change_limit", "max_abs_pct": 0.21, "requires_field": "prev_close", "error_code": "0x3004", "note": "缺 prev_close 或其为 0 时跳过该项检查，不视为失败（首个交易日/停牌复牌无可比昨收）"}
  ],
  "error_codes": {
    "missing_field_or_invalid_json": "0x3001",
    "non_positive_price_or_negative_volume": "0x3002",
    "ohlc_inconsistent": "0x3003",
    "pct_change_exceeded": "0x3004"
  }
}
